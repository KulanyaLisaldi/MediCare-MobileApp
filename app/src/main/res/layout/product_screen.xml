<?xml version="1.0" encoding="utf-8"?>
<!-- GridLayout requires androidx.gridlayout:gridlayout:1.0.0 dependency -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:grid="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProductScreen">

    <!-- Top bar with back and search -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back_button"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_icon"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/search_products"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:inputType="text" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/mic_icon"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Upload prescription card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/social_section_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Medicine with prescription"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/upload_prescription_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:text="Upload Prescription"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/brand_primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section: Skin Care -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Skin Care"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pain_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View more"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2"
                app:rowCount="1"
                app:useDefaultMargins="true">

                <!-- Product Card 1 (Skin Care) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/first_product_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/skincare1" />

                            <ImageView
                                android:id="@+id/cart_icon_1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:src="@drawable/ic_cart"
                                app:tint="@color/text_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Vitamin C Serum"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rs. 2000"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Product Card 2 (Skin Care) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/second_product_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/skincare2" />

                            <ImageView
                                android:id="@+id/cart_icon_2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:src="@drawable/ic_cart"
                                app:tint="@color/text_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CeraVe SA Cleanser"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rs. 2500"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </androidx.gridlayout.widget.GridLayout>

            <!-- Section: Supplements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Supplements"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/supp_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View more"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp" />
            </LinearLayout>

                         <androidx.gridlayout.widget.GridLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 app:columnCount="2"
                 app:rowCount="1"
                 app:useDefaultMargins="true">

                                 <!-- Product Card 3 (Supplements) -->
                 <androidx.cardview.widget.CardView
                     android:id="@+id/third_product_card"
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     app:layout_columnWeight="1"
                     app:cardCornerRadius="12dp"
                     app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/suppliment" />

                            <ImageView
                                android:id="@+id/cart_icon_3"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:src="@drawable/ic_cart"
                                app:tint="@color/text_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Vitamin D3 Gummies"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rs. 1800"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                                 <!-- Product Card 4 (Supplements) -->
                 <androidx.cardview.widget.CardView
                     android:id="@+id/fourth_product_card"
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     app:layout_columnWeight="1"
                     app:cardCornerRadius="12dp"
                     app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/painkiller" />

                            <ImageView
                                android:id="@+id/cart_icon_4"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:src="@drawable/ic_cart"
                                app:tint="@color/text_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Centrum MultiGummies"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rs. 3200"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp" />
                    </LinearLayout>
                                                  </androidx.cardview.widget.CardView>
             </androidx.gridlayout.widget.GridLayout>

             <!-- Section: Additional Supplements -->
             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:gravity="center_vertical"
                 android:layout_marginTop="16dp"
                 android:layout_marginBottom="8dp">

                 <TextView
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     android:layout_weight="1"
                     android:text="Additional Supplements"
                     android:textColor="@color/text_primary"
                     android:textSize="15sp"
                     android:textStyle="bold" />

                 <TextView
                     android:id="@+id/additional_supp_more"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="View more"
                     android:textColor="@color/brand_primary"
                     android:textSize="13sp" />
             </LinearLayout>

             <androidx.gridlayout.widget.GridLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 app:columnCount="2"
                 app:rowCount="1"
                 app:useDefaultMargins="true">

                 <!-- Product Card 5 (Additional Supplements) -->
                 <androidx.cardview.widget.CardView
                     android:id="@+id/fifth_product_card"
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     app:layout_columnWeight="1"
                     app:cardCornerRadius="12dp"
                     app:cardElevation="2dp">

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="vertical">

                         <FrameLayout
                             android:layout_width="match_parent"
                             android:layout_height="140dp">

                             <ImageView
                                 android:layout_width="match_parent"
                                 android:layout_height="match_parent"
                                 android:scaleType="centerCrop"
                                 android:src="@drawable/suppliment" />

                             <ImageView
                                 android:id="@+id/cart_icon_5"
                                 android:layout_width="24dp"
                                 android:layout_height="24dp"
                                 android:layout_gravity="end|top"
                                 android:layout_margin="8dp"
                                 android:src="@drawable/ic_cart"
                                 app:tint="@color/text_primary" />
                         </FrameLayout>

                         <TextView
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Omega-3 Fish Oil"
                             android:textColor="@color/text_primary"
                             android:textSize="13sp"
                             android:paddingStart="8dp"
                             android:paddingEnd="8dp"
                             android:paddingTop="6dp" />

                         <TextView
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Rs. 2500"
                             android:textColor="@color/text_secondary"
                             android:textSize="12sp"
                             android:paddingStart="8dp"
                             android:paddingEnd="8dp"
                             android:paddingBottom="10dp" />
                     </LinearLayout>
                 </androidx.cardview.widget.CardView>

                 <!-- Product Card 6 (Additional Supplements) -->
                 <androidx.cardview.widget.CardView
                     android:id="@+id/sixth_product_card"
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     app:layout_columnWeight="1"
                     app:cardCornerRadius="12dp"
                     app:cardElevation="2dp">

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="vertical">

                         <FrameLayout
                             android:layout_width="match_parent"
                             android:layout_height="140dp">

                             <ImageView
                                 android:layout_width="match_parent"
                                 android:layout_height="match_parent"
                                 android:scaleType="centerCrop"
                                 android:src="@drawable/painkiller" />

                             <ImageView
                                 android:id="@+id/cart_icon_6"
                                 android:layout_width="24dp"
                                 android:layout_height="24dp"
                                 android:layout_gravity="end|top"
                                 android:layout_margin="8dp"
                                 android:src="@drawable/ic_cart"
                                 app:tint="@color/text_primary" />
                         </FrameLayout>

                         <TextView
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Protein Powder"
                             android:textColor="@color/text_primary"
                             android:textSize="13sp"
                             android:paddingStart="8dp"
                             android:paddingEnd="8dp"
                             android:paddingTop="6dp" />

                         <TextView
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Rs. 4200"
                             android:textColor="@color/text_secondary"
                             android:textSize="12sp"
                             android:paddingStart="8dp"
                             android:paddingEnd="8dp"
                             android:paddingBottom="10dp" />
                     </LinearLayout>
                 </androidx.cardview.widget.CardView>
             </androidx.gridlayout.widget.GridLayout>
         </LinearLayout>
     </ScrollView>

    <!-- Bottom Navigation (reuse same visuals) -->
    <include
        layout="@layout/bottom_nav_product"
        android:id="@+id/product_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


