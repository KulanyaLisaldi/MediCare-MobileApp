<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".SignInScreen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back_button"
            android:layout_marginStart="12dp"
            android:layout_marginTop="40dp"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Sign In Title -->
        <TextView
            android:id="@+id/sign_in_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_in_title"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Login Picture -->
        <ImageView
            android:id="@+id/login_picture"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/login_picture"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/login_picture_desc"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/sign_in_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.3" />

            <!-- Input Fields Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/input_fields_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="-16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/login_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Email Input Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_field_background"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_email"
                        android:contentDescription="@string/email_icon_desc"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/email_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/enter_email_hint"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:background="@null"
                        android:inputType="textEmailAddress"
                        android:padding="0dp" />

                </LinearLayout>

                <!-- Password Input Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_field_background"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@string/password_icon_desc"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/password_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/enter_password_hint"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:padding="0dp" />

                </LinearLayout>

                <!-- Forgot Password Link -->
                <TextView
                    android:id="@+id/forgot_password_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textSize="13sp"
                    android:textColor="@color/brand_primary"
                    android:layout_gravity="end"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Sign In Button -->
                <Button
                    android:id="@+id/sign_in_submit_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/sign_in"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/brand_primary"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Social Media Section -->
        <LinearLayout
            android:id="@+id/social_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/social_section_background"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/input_fields_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Separator with "or continue with" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/separator_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or_continue_with"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/separator_color" />

            </LinearLayout>

            <!-- Social Media Icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Google Icon -->
                <ImageView
                    android:id="@+id/google_icon_signin"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_google"
                    android:contentDescription="@string/google_icon_desc"
                    android:background="@drawable/social_icon_background"
                    android:padding="10dp"
                    android:layout_marginEnd="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/white" />

                <!-- Facebook Icon -->
                <ImageView
                    android:id="@+id/facebook_icon_signin"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_facebook"
                    android:contentDescription="@string/facebook_icon_desc"
                    android:background="@drawable/social_icon_background"
                    android:padding="10dp"
                    android:layout_marginEnd="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/white" />

                <!-- Apple Icon -->
                <ImageView
                    android:id="@+id/apple_icon_signin"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_apple"
                    android:contentDescription="@string/apple_icon_desc"
                    android:background="@drawable/social_icon_background"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
